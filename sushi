#!/usr/bin/env bash
#
# sushi — fuzzy SSH connection picker backed by ~/.ssh/config
#
#   sushi              open the fuzzy picker
#   sushi <query>      open the picker pre-filtered
#   sushi scan         discover user@host from shell history, import into ~/.ssh/config
#   sushi scan -n      dry run: show what scan would add, write nothing
#   sushi add <dest>   import one host by hand: sushi add deploy@web1.example.com
#   sushi ignore       stop scan offering something (also: delete, rm)
#   sushi ignore -l    show the ignore list
#   sushi list         print the host table (no fzf needed)
#   sushi edit         open ~/.ssh/config in $EDITOR
#   sushi theme        show the active theme, where it came from, and where to put one
#   sushi theme list   list every theme on the search path (also: sushi themes)
#   sushi theme set    pick a theme in fzf and keep it; `set <name>` skips the picker
#   sushi choose       print the chosen alias instead of connecting
#   sushi export       write sanitized Host stanzas to a share file (alias: share)
#   sushi import FILE  merge a share file into ~/.ssh/config
#   sushi doctor       check binaries, ~/.ssh, the integration, the theme
#   sushi --version    print the version
#
# Requires: bash 3.2+, awk, ssh. fzf only for the picker.
# Shell integration (bare `ssh` opens the picker) lives in sushi.zsh.
# Files: ~/.ssh/config (SUSHI_CONFIG), ~/.ssh/sushi-ignore (SUSHI_IGNORE)
#        themes/<name>.yaml, ~/.config/sushi/themes/<name>.yaml (SUSHI_THEME)

set -uo pipefail

VERSION="0.3.0"

# Follow $0 so a symlink on PATH still finds lib/ next to the real script.
SELF="$0"
while [ -L "$SELF" ]; do
  _dir="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)" || break
  _tgt="$(readlink "$SELF")"
  case "$_tgt" in /*) SELF="$_tgt" ;; *) SELF="$_dir/$_tgt" ;; esac
done
SELF="$(cd "$(dirname "$SELF")" 2>/dev/null && pwd)/$(basename "$SELF")"
unset _dir _tgt
SSH_DIR="${SSH_DIR:-$HOME/.ssh}"
CONFIG="${SUSHI_CONFIG:-$SSH_DIR/config}"
IGNORE="${SUSHI_IGNORE:-$SSH_DIR/sushi-ignore}"
BEGIN_MARK="# >>> sushi managed hosts >>>"
END_MARK="# <<< sushi managed hosts <<<"

# `sushi --theme` writes one line into the shell rc and has to find it again to
# replace it. Its own markers, distinct from install.sh's `# >>> sushi >>>` —
# the theme line lives just above that block, never inside it, because
# install.sh rewrites everything between its own markers on every run.
THEME_BEGIN="# >>> sushi theme >>>"
THEME_END="# <<< sushi theme <<<"
INSTALL_BEGIN="# >>> sushi >>>"

# Every subcommand name the dispatcher at the bottom handles. Published via
# `sushi __subcommands` so sushi.zsh's wrapper function does not have to keep a
# second copy in sync — it got one wrong once and silently turned `sushi ignore`
# into a picker search for the word "ignore".
SUBCOMMANDS='scan add ignore delete rm list ls edit theme themes help choose export share import doctor version'

die()  { printf 'sushi: %s\n' "$*" >&2; exit 1; }
warn() { printf 'sushi: %s\n' "$*" >&2; }
have() { command -v "$1" >/dev/null 2>&1; }

# ~/.ssh/config reads better than /Users/you/.ssh/config, and is what someone
# would type back at you.
tilde() {
  local d="$1"
  # shellcheck disable=SC2088  # a literal ~ is what we want to display
  case "$d" in "$HOME"/*) d="~/${d#"$HOME"/}" ;; esac
  printf '%s\n' "$d"
}

LIB="$(cd "$(dirname "$SELF")" && pwd)/lib"
# shellcheck source=lib/util.sh
source "$LIB/util.sh"
# shellcheck source=lib/theme.sh
source "$LIB/theme.sh"
# shellcheck source=lib/config.sh
source "$LIB/config.sh"
# shellcheck source=lib/history.sh
source "$LIB/history.sh"
# shellcheck source=lib/ignore.sh
source "$LIB/ignore.sh"
# shellcheck source=lib/commands.sh
source "$LIB/commands.sh"
# shellcheck source=lib/share.sh
source "$LIB/share.sh"

case "${1:-}" in
  ""|-\?)            cmd_pick "" ;;
  scan)              shift; cmd_scan "$@" ;;
  add)               shift; cmd_add "$@" ;;
  ignore|delete|rm)  shift; cmd_ignore "$@" ;;
  list|ls)           cmd_list ;;
  choose)            run_picker "${2:-}" ;;      # print an alias, don't connect
  export|share)      shift; cmd_export "$@" ;;
  import)            shift; cmd_import "$@" ;;
  __rmalias)         shift; names=""             # internal: delete managed stanzas
                     for a in "$@"; do names="$names
$a"; done
                     remove_managed_aliases "$names" ;;
  __preview)         cmd_preview "${2:-}" ;;     # internal: fzf preview pane
  __lines)           shift; picker_lines "" "${1:-}" ;;   # internal: the picker's rows
  __pickerfeed)      shift; picker_feed "${1:-}" ;;  # internal: header + rows, for reload
  __aliases)         config_hosts | AWK -F'\t' '{ print $1 }' | sort -f ;;  # for completion
  __fzfhint)         fzf_install_cmd; printf '\n' ;;   # internal: install.sh reuses this
  __themes)          theme_names ;;                # internal: theme names, for completion
  __themepreview)    cmd_theme_preview ;;          # internal: theme picker's preview pane
  __fzfreload)       fzf_reload_action; printf '\n' ;;  # internal: which reload ctrl-s gets
  __subcommands)     printf '%s\n' "$SUBCOMMANDS" | tr ' ' '\n' ;;
  __scanmenu)        scan_menu ;;                # internal: scan picker's fzf input
  __ignoremenu)      ignore_rows ;;             # internal: ignore picker's fzf input
  __ignoresplit)     ignore_split_selection ;;  # internal: selection -> P/D stream
  __menucache)       menu_from_cache ;;          # internal: reload from the cache
  __pend)            shift; pend_add "$@" ;;     # internal: note a ctrl-x dismissal
  __candidates)      scan_history ;;             # internal: raw history scan
  __extract)         extract_stream ;;          # internal: history lines -> records
  theme)             shift; cmd_theme "$@" ;;
  themes)            cmd_themes ;;                 # alias for `theme list`
  doctor)            shift; cmd_doctor "$@" ;;
  edit)              exec "${EDITOR:-vi}" "$CONFIG" ;;
  help|-h|--help)    usage ;;
  version|--version|-V) cmd_version ;;
  *)                 cmd_pick "$1" ;;
esac
